---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { readingCategories } from '@/data';
---

<BaseLayout title="Reading" description="Books, essays, films, and artists currently living in Aadrika's head.">
  <div class="page reading-page">
    <PageIntro kicker="04 — INDEX" title="assorted brain contaminants." deck="Books, essays, films, and artists. No ranking, no algorithm, no defensible organizing principle beyond affection." />
    {readingCategories.map((category, categoryIndex) => (
      <section class="reading-section" aria-labelledby={`reading-${categoryIndex}`}>
        <header>
          <h2 id={`reading-${categoryIndex}`}>{category.title}</h2>
          <span class="mono">{String(category.items.length).padStart(2, '0')}</span>
        </header>
        <ol>
          {category.items.map((item, index) => (
            <li>
              <span class="mono item-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="item-title">{item.title}</span>
              <span class="mono item-by">{item.by}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .reading-section {
    display: grid;
    grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1.55fr);
    border-bottom: 1px solid var(--line);
  }

  .reading-section > header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 28px var(--page-gutter);
    border-right: 1px solid var(--line);
  }

  .reading-section h2 { margin: 0; font-size: clamp(25px, 3vw, 40px); letter-spacing: -0.05em; }
  .reading-section header span { color: var(--blue); font-size: 10px; }
  .reading-section ol { margin: 0; padding: 0; list-style: none; }

  .reading-section li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) minmax(120px, 220px);
    gap: 12px;
    padding: 13px 24px;
    border-bottom: 1px solid var(--line-soft);
  }

  .reading-section li:last-child { border-bottom: 0; }
  .item-number, .item-by { color: var(--muted); font-size: 9px; line-height: 1.5; }
  .item-title { font-size: 15px; letter-spacing: -0.018em; }

  @media (max-width: 760px) {
    .reading-section { grid-template-columns: 1fr; }
    .reading-section > header { border-right: 0; border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 520px) {
    .reading-section li { grid-template-columns: 30px 1fr; }
    .item-by { grid-column: 2; }
  }
</style>
