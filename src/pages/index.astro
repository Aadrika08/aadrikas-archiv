---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DoodleStar from '@/components/DoodleStar.astro';
import WordGame from '@/components/WordGame';
import { currently, featuredWriting, homeInvites } from '@/data';

const writing = await getCollection('writing', ({ data }) => !data.draft);
const writingBySlug = new Map(writing.map((entry) => [entry.data.slug, entry]));
---

<BaseLayout>
  <div class="page home-page">
    <section class="home-hero">
      <DoodleStar class="hero-star hero-star-a" />
      <DoodleStar class="hero-star hero-star-b" />
      <DoodleStar class="hero-star hero-star-c" />
      <DoodleStar class="hero-star hero-star-d" />

      <div class="hero-meta">
        <p class="mono hero-label">AADRIKA'S ARCHIVE<br /><span class="blue">FIELD NOTES OF A CURIOUS PERSON</span></p>
        <div class="mono hero-note">
          <p><span class="blue">this is where i keep the evidence.</span> research, experiments, writing, things i've built, things i love, and several things that probably did not need their own webpage.</p>
          <p class="muted">mostly this means EEG, neurotechnology, and getting science into places it doesn't usually reach — plus whatever else refuses to leave me alone.</p>
        </div>
      </div>

      <h1 class="display-copy">hi, i'm <span class="script blue">aadrika</span>. i study brains, poke at machines, build things with people, and write about questions that refuse to leave me alone.</h1>
    </section>

    <section class="section currently-section">
      <span class="section-number">01</span>
      <p class="eyebrow">{currently.label}</p>
      <p class="currently-copy">{currently.text}<span class="blue cursor-block" aria-hidden="true">▊</span></p>
    </section>

    <section class="section invite-section">
      <span class="section-number">02</span>
      <div class="invite-list">
        {homeInvites.map((invite) => (
          <a class="invite-link" href={invite.href}>
            <span class="mono invite-key">{invite.key}</span>
            <span>{invite.description}</span>
            <span class="mono invite-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="mono invite-footnote">↳ mostly this means EEG, neurotechnology, and getting science into places it doesn't usually reach.</p>
    </section>

    <section class="section featured-section">
      <span class="section-number">03</span>
      <p class="eyebrow">FEATURED WRITING</p>
      <div class="featured-list">
        {featuredWriting.map((feature) => {
          const entry = writingBySlug.get(feature.slug);
          return entry && (
            <a class="featured-link" href={`/writing/${entry.data.slug}`}>
              <span class="mono">{feature.index}</span>
              <span>{entry.data.title}</span>
              <span aria-hidden="true">↗</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section game-section">
      <span class="section-number">04</span>
      <p class="eyebrow muted">↓ ONE SMALL GAME</p>
      <WordGame client:visible />
    </section>

    <section class="section leave-evidence">
      <span class="section-number">05</span>
      <h2>you were here. <span class="blue">leave evidence.</span></h2>
      <p>leave me a thought, question, recommendation, or sentence. it'll become another star in the constellation of people who wandered through here.</p>
      <a class="button" href="/guestbook">leave a star ✦</a>
      <p class="mono leave-note">no email required. no networking objective. you're allowed to simply have been here.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: flex;
    min-height: 90vh;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 40px var(--page-gutter) 54px;
    border-bottom: 1px solid var(--line);
  }

  .hero-meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-label {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.8;
  }

  .hero-note {
    width: 300px;
    max-width: 100%;
    color: var(--ink-soft);
    font-size: 11px;
    line-height: 1.8;
    text-align: justify;
  }

  .hero-note p {
    margin: 0 0 12px;
  }

  .home-hero .display-copy {
    position: relative;
    z-index: 2;
  }

  :global(.hero-star) {
    position: absolute;
    color: var(--blue);
    pointer-events: none;
  }

  :global(.hero-star-a) { top: 23%; left: 10%; width: 82px; transform: rotate(-10deg); }
  :global(.hero-star-b) { top: 13%; left: 53%; width: 50px; transform: rotate(14deg); opacity: 0.76; }
  :global(.hero-star-c) { top: 32%; left: 34%; width: 60px; transform: rotate(-5deg); opacity: 0.86; }
  :global(.hero-star-d) { top: 42%; left: 6%; width: 40px; transform: rotate(9deg); opacity: 0.7; }

  .currently-copy {
    max-width: 680px;
    margin: 0;
    font-size: 16px;
    letter-spacing: -0.012em;
    line-height: 1.55;
  }

  .cursor-block {
    margin-left: 3px;
    animation: blink 1.1s steps(1) infinite;
  }

  .invite-list {
    display: grid;
  }

  .invite-link {
    display: grid;
    grid-template-columns: 142px minmax(0, 1fr) 24px;
    gap: 14px;
    align-items: baseline;
    padding: 8px;
    font-size: 15px;
  }

  .invite-link:hover {
    color: var(--ink);
    background: var(--blue-soft);
  }

  .invite-key,
  .invite-arrow {
    color: var(--blue);
    font-size: 11px;
  }

  .invite-arrow {
    opacity: 0;
    transition: opacity 120ms ease, transform 120ms ease;
  }

  .invite-link:hover .invite-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .invite-footnote,
  .leave-note {
    max-width: 560px;
    margin: 10px 8px 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.65;
  }

  .featured-list {
    border-top: 1px solid var(--line-soft);
  }

  .featured-link {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: 14px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line-soft);
    font-size: clamp(18px, 2.4vw, 27px);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .featured-link .mono {
    color: var(--blue);
    font-size: 10px;
    font-weight: 400;
  }

  .featured-link:hover {
    color: #ffffff;
    background: #1a1aff;
  }

  .featured-link:hover .mono {
    color: #ffffff;
  }

  .leave-evidence {
    background: var(--paper-soft);
  }

  .leave-evidence h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(28px, 3.5vw, 44px);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .leave-evidence > p:not(.leave-note) {
    max-width: 590px;
    margin: 14px 0 18px;
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .home-hero {
      min-height: calc(100vh - 58px);
      padding-top: 26px;
    }

    .hero-note {
      width: 100%;
      text-align: left;
    }

    :global(.hero-star-a) { left: 66%; }
    :global(.hero-star-c) { top: 43%; left: 19%; }

    .invite-link {
      grid-template-columns: 112px minmax(0, 1fr) 16px;
      font-size: 13px;
    }
  }
</style>
