---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} article>
  <article class="page post-page">
    <header class="post-header">
      <a class="mono back-link" href="/writing">← ALL WRITING</a>
      <p class="eyebrow">{entry.data.year} · {entry.data.kind} · {entry.data.status}</p>
      <h1>{entry.data.title}</h1>
      <p class="post-summary">{entry.data.summary}</p>
    </header>
    <div class="post-layout">
      <div class:list={["post-prose", { "is-unfinished": entry.data.status === 'unfinished' }]}>
        {entry.data.status === 'unfinished' ? (
          <div class="terminal-draft" aria-label="Unfinished draft notice">
            <p>&gt; system.boot_sequence initiated...</p>
            <p>&gt; loading interface: archive_shell_v2.03</p>
            <p>&gt; status: <span>OK</span></p>
            <br />
            <p>[INFO] thoughts synchronized.</p>
            <p>[WARN] feelings rendering above threshold — honesty mode enabled.</p>
            <br />
            <p>&gt;&gt; author: AADRIKA</p>
            <p>&gt;&gt; access level: unfinished.draft</p>
            <br />
            <p>// this is where the real piece will live.</p>
            <p>// every line is still becoming itself.</p>
            <br />
            <p>&gt; working title:</p>
            <p class="terminal-title">“{entry.data.title}”</p>
            <p>&gt; end_of_line // <span class="terminal-cursor">▊</span></p>
          </div>
        ) : <Content />}
      </div>
      <aside class="post-aside">
        <p class="mono">{String(headings.length).padStart(2, '0')} SECTIONS</p>
        <p>Written slowly, revised unevenly, and published before becoming perfectly behaved.</p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding: clamp(36px, 7vw, 100px) var(--page-gutter) 48px;
    border-bottom: 1px solid var(--line);
  }

  .back-link { display: inline-block; margin-bottom: 42px; color: var(--blue); font-size: 10px; }
  .post-header h1 { max-width: 1000px; margin: 0; font-size: clamp(48px, 8vw, 108px); letter-spacing: -0.065em; line-height: 0.9; text-wrap: balance; }
  .post-summary { max-width: 660px; margin: 30px 0 0; color: var(--ink-soft); font-size: 19px; line-height: 1.55; }
  .post-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(220px, 320px); gap: clamp(40px, 8vw, 120px); justify-content: center; padding: clamp(42px, 7vw, 100px) var(--page-gutter); }
  .post-prose { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.82; }
  .post-prose :global(p) { margin: 0 0 1.55em; }
  .post-prose :global(p:first-child) { font-size: 1.18em; line-height: 1.62; }
  .post-prose :global(h2) { margin: 2.4em 0 0.7em; font-size: 2.1em; letter-spacing: -0.045em; line-height: 1.05; }
  .terminal-draft { border: 1px solid var(--blue); padding: clamp(22px, 4vw, 42px); color: #ffffff; background: #09092b; box-shadow: 10px 10px 0 var(--blue-soft); font-family: var(--mono); font-size: clamp(11px, 1.35vw, 14px); line-height: 1.65; }
  .terminal-draft p { margin: 0 !important; }
  .terminal-draft span { color: #8cffb1; }
  .terminal-title { margin-left: 2em !important; color: #aeb2ff; }
  .terminal-cursor { color: #ffffff !important; animation: blink 1s steps(1) infinite; }
  .post-aside { position: sticky; top: 34px; align-self: start; padding-top: 5px; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .post-aside .mono { color: var(--blue); font-size: 9px; }

  @media (max-width: 820px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-aside { position: static; grid-row: 1; border-bottom: 1px solid var(--line-soft); padding-bottom: 24px; }
  }
</style>
