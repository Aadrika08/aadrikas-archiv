# Public browser configuration
PUBLIC_SITE_URL=https://example.com
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Server-only secrets. Never expose these with a PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TURNSTILE_SECRET_KEY=your-turnstile-secret
RATE_LIMIT_SECRET=generate-a-long-random-secret

# Contact delivery through Resend
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@example.com>
